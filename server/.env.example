PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Engine: Inbuilt persistent Firebase/Firestore store (Zero cloud setup required)
DATABASE_ENGINE=firebase_inbuilt
FIREBASE_USE_LOCAL=true

# Optional: Google Firebase Cloud Credentials (if connecting to real Google Cloud Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Security Secrets
JWT_SECRET=campus_voice_secure_jwt_secret_dev_2026
JWT_EXPIRES_IN=7d
ANONYMITY_SALT=campus_voice_anonymity_salt_key_2026

# Google Gemini API Key (optional: rule-based NLP fallback engine activates automatically if omitted)
GEMINI_API_KEY=

# Moderation Thresholds (0.0 to 1.0)
AI_AUTO_APPROVE_THRESHOLD=0.35
AI_AUTO_REJECT_THRESHOLD=0.75

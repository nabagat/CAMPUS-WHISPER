# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave empty to use automatic embedded in-memory MongoDB for local testing)
MONGODB_URI=

# Security & Secrets
JWT_SECRET=super_secret_jwt_key_campus_voice_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=campus_voice_cookie_secret_key

# Google Gemini AI Integration (Optional: fallback heuristic engine activates automatically if omitted)
GEMINI_API_KEY=

# Moderation Thresholds (0.0 - 1.0)
AI_AUTO_APPROVE_THRESHOLD=0.35
AI_AUTO_REJECT_THRESHOLD=0.75
